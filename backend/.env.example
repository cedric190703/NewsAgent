# ---------------------------------------------------------------------------
# Copy to backend/.env and edit. Every value here is also a real default,
# so the app runs with no .env at all (using the mock providers).
# List values accept CSV (A,B) or JSON (["A","B"]).
# ---------------------------------------------------------------------------

APP_NAME="AI News Agent"
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173

# Logging: DEBUG | INFO | WARNING | ERROR. JSON_LOGS=true for structured output.
LOG_LEVEL=INFO
JSON_LOGS=false

# --- LLM -------------------------------------------------------------------
# "mock" needs no model and still exercises every LLM branch of the graph.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=2
LLM_TEMPERATURE=0.2

# --- Search providers ------------------------------------------------------
# "auto" uses every provider that has credentials, and falls back to the mock.
SEARCH_PROVIDERS=auto
# TAVILY_API_KEY=tvly-xxx
# TAVILY_SEARCH_DEPTH=basic
# NEWSAPI_KEY=xxx
# NEWSAPI_LANGUAGE=en

# Override the built-in feed list (Google News, BBC, Verge, Ars, Wired, Nature,
# Science, Guardian) with your own.
# RSS_FEEDS=https://example.com/feed.xml,https://other.example/rss

# --- Fetching --------------------------------------------------------------
SOURCE_FETCH_TIMEOUT_SECONDS=15
ENABLE_ARTICLE_EXTRACTION=true
MAX_CONCURRENT_FETCHES=8
MAX_DOWNLOAD_BYTES=5000000
FEED_CACHE_TTL_SECONDS=300
ARTICLE_CACHE_TTL_SECONDS=900
# Disables the SSRF guard. Only for tests or a trusted intranet.
ALLOW_PRIVATE_FETCH_TARGETS=false

# --- Graph behaviour -------------------------------------------------------
ENABLE_FACTCHECK=true
RESULTS_PER_SUBTOPIC=8
MIN_RELEVANT_RESULTS=4
MAX_SEARCH_ATTEMPTS=2
RELEVANCE_THRESHOLD=0.35
# Topic terms required in a headline/lede before an article can be selected.
# Capped by how many terms the theme has; relaxed to 1 on a widened retry.
MIN_TOPIC_TERMS=2

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60

# --- Storage (paths inside the container) ----------------------------------
DATA_DIR=/app/data
CHECKPOINT_DB=/app/data/checkpoints.sqlite
RUNS_DB=/app/data/runs.sqlite
RUN_HISTORY_LIMIT=500
