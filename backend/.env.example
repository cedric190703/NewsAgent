APP_NAME="AI News Agent"
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]

# Use "mock" to test without Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=2

# Search providers: "auto" uses all with credentials, falls back to mock
SEARCH_PROVIDERS=["auto"]
# TAVILY_API_KEY=tvly-xxx
# NEWSAPI_KEY=xxx

# Graph behavior
ENABLE_FACTCHECK=true
RESULTS_PER_SUBTOPIC=8
MAX_SEARCH_ATTEMPTS=2

# Storage (inside container)
DATA_DIR=/app/data
CHECKPOINT_DB=/app/data/checkpoints.sqlite
RUNS_DB=/app/data/runs.sqlite

# Optional: override RSS feeds (defaults to Google News, BBC, Verge, etc.)
# RSS_FEEDS=["https://example.com/feed.xml"]
SOURCE_FETCH_TIMEOUT_SECONDS=15

# Admin password for creating runs and managing topics
ADMIN_PASSWORD=admin123

# SMTP for sending newsletters to mailing list
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=Good News Agent
# SMTP_USE_TLS=true
